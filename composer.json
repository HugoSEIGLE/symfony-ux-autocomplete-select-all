{
  "name": "hugoseigle/symfony-ux-autocomplete-select-all",
  "type": "symfony-bundle",
  "description": "Select or deselect every option in a Symfony UX Autocomplete field.",
  "keywords": [
    "autocomplete",
    "stimulus",
    "symfony",
    "symfony-ux",
    "tom-select"
  ],
  "homepage": "https://github.com/HugoSEIGLE/symfony-ux-autocomplete-select-all",
  "license": "MIT",
  "authors": [
    {
      "name": "Hugo Seigle",
      "homepage": "https://github.com/HugoSEIGLE"
    }
  ],
  "support": {
    "issues": "https://github.com/HugoSEIGLE/symfony-ux-autocomplete-select-all/issues",
    "source": "https://github.com/HugoSEIGLE/symfony-ux-autocomplete-select-all"
  },
  "require": {
    "php": ">=8.2",
    "symfony/dependency-injection": "^6.4|^7.0|^8.0",
    "symfony/http-kernel": "^6.4|^7.0|^8.0",
    "symfony/stimulus-bundle": "^2.13|^3.0",
    "symfony/ux-autocomplete": "^2.17"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^1.12|^2.0",
    "phpunit/phpunit": "^10.5|^11.0",
    "symfony/asset-mapper": "^6.4|^7.0|^8.0",
    "symfony/framework-bundle": "^6.4|^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "HugoSeigle\\SymfonyUx\\AutocompleteSelectAll\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HugoSeigle\\SymfonyUx\\AutocompleteSelectAll\\Tests\\": "tests/"
    }
  },
  "config": {
    "audit": {
      "block-insecure": false
    },
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "archive": {
    "name": "symfony-ux-autocomplete-select-all"
  },
  "scripts": {
    "check": [
      "@composer-validate",
      "@test",
      "@phpstan",
      "@cs-check"
    ],
    "cs-check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse",
    "test": "phpunit",
    "composer-validate": "composer validate --strict"
  }
}
