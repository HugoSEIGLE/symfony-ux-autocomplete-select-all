{
  "name": "symfony-ux-autocomplete-select-all-development",
  "private": true,
  "type": "module",
  "workspaces": [
    "assets"
  ],
  "scripts": {
    "build": "rollup assets/src/controller.js --file assets/dist/controller.js --format es --external @hotwired/stimulus",
    "check": "npm run lint && npm run format:check && npm test && npm run build:check",
    "build:check": "npm run build && git diff --exit-code -- assets/dist/controller.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint assets/src assets/tests",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hotwired/stimulus": "^3.2.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "rollup": "^4.30.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
