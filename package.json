{
  "name": "symfony-ux-autocomplete-select-all-development",
  "private": true,
  "type": "module",
  "workspaces": [
    "assets"
  ],
  "scripts": {
    "build": "rollup assets/src/controller.js --file assets/dist/controller.js --format es --external @hotwired/stimulus",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run audit && npm run lint && npm run format:check && npm test && npm run build:check",
    "build:check": "npm run build && git diff --exit-code -- assets/dist/controller.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint assets/src assets/tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@hotwired/stimulus": "^3.2.2",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^29.0.0",
    "prettier": "^3.9.0",
    "rollup": "^4.62.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
