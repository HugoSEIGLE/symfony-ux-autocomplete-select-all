{
  "name": "hugoseigle/symfony-ux-autocomplete-select-all-demo",
  "description": "AssetMapper demo for Symfony UX Autocomplete Select All.",
  "type": "project",
  "license": "MIT",
  "repositories": [
    {
      "type": "path",
      "url": "..",
      "options": {
        "symlink": true,
        "versions": {
          "hugoseigle/symfony-ux-autocomplete-select-all": "1.0.0"
        }
      }
    }
  ],
  "require": {
    "php": ">=8.2",
    "hugoseigle/symfony-ux-autocomplete-select-all": "^1.0",
    "symfony/asset": "6.4.*",
    "symfony/asset-mapper": "6.4.*",
    "symfony/console": "6.4.*",
    "symfony/dotenv": "6.4.*",
    "symfony/flex": "^2.5",
    "symfony/framework-bundle": "6.4.*",
    "symfony/runtime": "6.4.*",
    "symfony/twig-bundle": "6.4.*",
    "symfony/yaml": "6.4.*",
    "twig/extra-bundle": "^3.10",
    "twig/twig": "^3.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "6.4.*"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd"
    }
  }
}
